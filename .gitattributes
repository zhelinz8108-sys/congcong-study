# The listening library is required at runtime but is too large for ordinary
# Git blobs. Keep it versioned in GitHub through Git LFS.
study-plan/public/listening/** filter=lfs diff=lfs merge=lfs -text
study-plan/public/national-day-english/*.pdf binary

# Native release digests bind public JSON bytes; keep checkout bytes identical
# on Windows and Linux so question/answer pairs remain usable across devices.
study-plan/content/grade6-bank/*.json text eol=lf
study-plan/content/grade6-bank/sealed/*.json text eol=lf
