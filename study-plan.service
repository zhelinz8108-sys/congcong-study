[Unit]
Description=Congcong Study Plan Next.js app
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/www/study-plan
Environment=NODE_ENV=production
Environment=STORAGE_ROOT=/var/lib/study-plan/uploads
Environment=ASSET_BASE_URL=https://media.githubusercontent.com/media/zhelinz8108-sys/congcong-study/main/study-plan/public
Environment=ALLOW_LOCAL_DATA_FALLBACK=false
EnvironmentFile=-/etc/study-plan.env
ExecStart=/usr/bin/node /www/study-plan/node_modules/next/dist/bin/next start -p 3001 -H 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/study-plan/uploads /www/study-plan/.next
UMask=0022

[Install]
WantedBy=multi-user.target
