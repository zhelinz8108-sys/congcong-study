# Application access. Use a long random value for the secret in production.
FAMILY_ACCESS_PASSWORD=change-me
FAMILY_ACCESS_SECRET=change-me-to-a-long-random-secret

# PostgreSQL. DATABASE_URL takes precedence over the individual PG variables.
DATABASE_URL=postgresql://study_plan:change-me@127.0.0.1:5432/study_plan
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=study_plan
# PGUSER=study_plan
# PGPASSWORD=change-me

# Persistent server-side uploads. Keep this outside /www/study-plan so a
# deployment cannot delete user files.
STORAGE_ROOT=/var/lib/study-plan/uploads
# Optional absolute CDN/object-storage URL, for example https://cdn.example.com.
STORAGE_PUBLIC_BASE_URL=

# Production must not silently write learning records to temporary JSON files.
ALLOW_LOCAL_DATA_FALLBACK=false

# Optional asset host for large static learning media.
ASSET_BASE_URL=
